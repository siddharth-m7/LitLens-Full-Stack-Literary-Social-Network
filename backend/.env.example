# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://localhost:27017/book-review-app

# Auth
JWT_SECRET=change_this_to_a_long_random_secret

# Frontend (used in password reset emails)
FRONTEND_URL=http://localhost:5173

# Redis (caching) — defaults to redis://127.0.0.1:6379 if not set
REDIS_URL=redis://127.0.0.1:6379

# Cloudinary (cover image storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your_smtp_password
SMTP_FROM="Book Review App" <no-reply@example.com>
